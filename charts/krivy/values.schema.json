{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "krivy chart values",
  "type": "object",
  "required": ["image", "database", "scan", "trivy", "auth"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "kubernetes": {
      "type": "object",
      "properties": {
        "jobNamespace": { "type": "string" },
        "watchNamespace": { "type": "string" },
        "excludeNamespaces": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scanner": {
      "type": "object",
      "properties": {
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "imagePullSecrets": { "type": "array", "items": { "type": "object", "required": ["name"] } }
          }
        },
        "imagePullSecrets": { "type": "array", "items": { "type": "string" } },
        "registryAuth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecrets": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              }
            }
          }
        },
        "registrySecret": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$" }
      }
    },
    "database": {
      "type": "object",
      "required": ["driver"],
      "properties": {
        "driver": { "enum": ["sqlite", "postgres"] },
        "dsn": { "type": "string" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "size": { "type": "string" }
      }
    },
    "scan": {
      "type": "object",
      "properties": {
        "schedule": { "type": "string", "minLength": 1 },
        "maxConcurrentJobs": { "type": "integer", "minimum": 1, "maximum": 50 },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "scanOnStartup": { "type": "boolean" }
      }
    },
    "trivy": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "type": "string", "pattern": "^[^\\s]+[:@][^\\s]+$" },
        "severities": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["UNKNOWN", "LOW", "MEDIUM", "HIGH", "CRITICAL"] }
        },
        "timeout": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$" },
        "ttlAfterFinished": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$" },
        "maxOutputBytes": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "properties": {
            "requests": { "$ref": "#/definitions/resourceList" },
            "limits": { "$ref": "#/definitions/resourceList" }
          },
          "additionalProperties": false
        },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "scopes"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
              "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
              "scopes": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["read", "scan", "manage"] }
              },
              "revoked": { "type": "boolean" }
            }
          }
        }
      }
    },
    "notifications": {
      "type": "object",
      "properties": {
        "baseURL": { "type": "string" },
        "allowPrivateNetworks": { "type": "boolean" },
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url", "events"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "method": { "type": "string" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } },
              "events": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["new_critical", "resolved", "scan_failed"] }
              },
              "template": { "type": "string" },
              "contentType": { "type": "string" },
              "timeout": { "type": "string" },
              "maxRetries": { "type": "integer", "minimum": 0 },
              "namespaces": { "type": "array", "items": { "type": "string" } },
              "secrets": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "log": {
      "type": "object",
      "properties": {
        "level": { "type": "string" },
        "format": { "type": "string" }
      }
    },
    "existingSecret": { "type": "string" },
    "secret": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "data": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      }
    },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array" },
        "controller": {
          "type": "object",
          "properties": {
            "restrictEgress": { "type": "boolean" },
            "egressPorts": { "type": "array", "items": { "type": "integer" } },
            "extraEgress": { "type": "array" }
          }
        },
        "scanner": {
          "type": "object",
          "properties": {
            "podSelector": { "type": "object", "minProperties": 1 },
            "egressPorts": { "type": "array", "items": { "type": "integer" } },
            "egressCIDRs": { "type": "array", "items": { "type": "string" } },
            "extraEgress": { "type": "array" }
          }
        }
      }
    }
  },
  "definitions": {
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "string" },
        "memory": { "type": "string" },
        "ephemeralStorage": { "type": "string" }
      }
    }
  }
}
